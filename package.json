{
  "name": "parche-cli",
  "version": "0.8.0",
  "description": "Dependabot para APIs: detecta cambios de cualquier API de terceros en tu código (ARCA, Mercado Pago, OpenAI, Anthropic) y abre el PR con el arreglo.",
  "keywords": [
    "api",
    "migration",
    "codemod",
    "dependabot",
    "arca",
    "afip",
    "wsfe",
    "mercadopago",
    "github-action",
    "openai",
    "anthropic",
    "claude",
    "api-migration",
    "deprecation",
    "breaking-changes"
  ],
  "homepage": "https://getparche.com",
  "bugs": "https://github.com/Pepo08/parche/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pepo08/parche.git"
  },
  "author": "Joaquin Gonzalez Menza",
  "license": "MIT",
  "type": "module",
  "bin": {
    "parche": "bin/parche.js"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "data",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "bash demo.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "jscodeshift": "^17.3.0",
    "php-parser": "^3.7.0",
    "typescript": "~6.0.3"
  }
}
