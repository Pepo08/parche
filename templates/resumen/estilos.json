{
  "_nota": "Los estilos de los mails, inline (Gmail no lee <style> en todas las cuentas). $cond, $sans y $mono se reemplazan por las pilas de fuentes de abajo. Los colores son los de DESIGN.md, sin variables de CSS (Gmail no las lee).",
  "_fuentes": {
    "cond": "font-family:'Arial Narrow',HelveticaNeue-CondensedBold,'Helvetica Neue','Roboto Condensed',sans-serif-condensed,Arial,sans-serif;font-stretch:condensed;",
    "sans": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;",
    "mono": "font-family:ui-monospace,Menlo,Consolas,'Liberation Mono','Courier New',monospace;"
  },

  "hoja": "width:100%;max-width:600px;border:2px solid #111111;border-collapse:collapse;background:#ffffff;",
  "banda": "background:#74acdf;padding:12px 16px 11px;border-bottom:2px solid #111111;",
  "marca": "$cond font-weight:800;font-size:24px;line-height:24px;letter-spacing:0.02em;text-transform:uppercase;color:#0b2545;",
  "banda_etiqueta": "$mono font-size:11px;line-height:15px;letter-spacing:0.06em;text-transform:uppercase;color:#0b2545;",
  "meta": "$mono font-size:12px;line-height:16px;letter-spacing:0.04em;text-transform:uppercase;color:#3d5573;padding:10px 16px 9px;border-bottom:1px solid #111111;",

  "lead": "padding:24px 16px 4px;",
  "titular": "$cond font-weight:800;font-size:42px;line-height:40px;color:#0b2545;margin:0;",
  "titular_aviso": "$cond font-weight:800;font-size:34px;line-height:34px;color:#0b2545;margin:0;",
  "lead_texto": "padding:12px 16px 20px;",
  "parrafo": "$sans font-size:16px;line-height:24px;color:#0b2545;margin:0 0 12px;word-break:break-word;",
  "parrafo_ultimo": "$sans font-size:16px;line-height:24px;color:#0b2545;margin:0;word-break:break-word;",
  "parrafo_falla": "$sans font-size:15px;line-height:22px;color:#0b2545;margin:8px 0 0;word-break:break-word;",

  "tira": "background:#74acdf;padding:7px 16px 6px;border-top:2px solid #111111;border-bottom:1px solid #111111;",
  "tira_titulo": "$mono margin:0;font-weight:500;font-size:11px;line-height:15px;letter-spacing:0.06em;text-transform:uppercase;color:#0b2545;",
  "seccion": "background:#74acdf;padding:9px 16px 8px;border-top:2px solid #111111;border-bottom:1px solid #111111;",
  "seccion_titulo": "$cond margin:0;font-weight:800;font-size:21px;line-height:22px;color:#0b2545;",
  "seccion_num": "$mono font-weight:500;font-size:12px;letter-spacing:0.04em;",
  "cliente_banda": "background:#0b2545;padding:10px 16px 9px;border-top:2px solid #111111;",
  "cliente_titulo": "$cond margin:0;font-weight:800;font-size:22px;line-height:22px;text-transform:uppercase;color:#ffffff;",
  "revision_celda": "padding:16px 16px 6px;",

  "fila": "padding:0;border-top:1px solid #111111;",
  "fila_primera": "padding:0;",
  "cabecera_fecha": "width:104px;padding:6px 10px 5px 16px;border-right:1px solid #111111;$mono font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;color:#3d5573;",
  "cabecera": "padding:6px 16px 5px 14px;$mono font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;color:#3d5573;",

  "celda_fecha": "width:104px;padding:13px 10px 14px 16px;border-right:1px solid #111111;vertical-align:top;",
  "celda_etiqueta": "width:104px;padding:14px 10px 14px 16px;border-right:1px solid #111111;vertical-align:top;$mono font-size:11px;line-height:14px;letter-spacing:0.05em;text-transform:uppercase;color:#0b2545;",
  "celda_texto": "padding:12px 16px 14px 14px;vertical-align:top;",
  "fecha_roja": "$cond font-weight:800;font-size:30px;line-height:28px;color:#d7263d;white-space:nowrap;",
  "fecha_tinta": "$cond font-weight:800;font-size:30px;line-height:28px;color:#0b2545;white-space:nowrap;",
  "fecha_pie_roja": "$mono font-size:11px;line-height:14px;letter-spacing:0.03em;text-transform:uppercase;color:#d7263d;padding-top:6px;",
  "fecha_pie_tinta": "$mono font-size:11px;line-height:14px;letter-spacing:0.03em;text-transform:uppercase;color:#3d5573;padding-top:6px;",
  "fecha_sin": "$cond font-weight:700;font-size:20px;line-height:20px;color:#3d5573;",
  "fecha_hecha": "$cond font-weight:800;font-size:26px;line-height:26px;color:#0b2545;white-space:nowrap;",

  "celda_fecha_grande": "width:128px;padding:14px 12px 16px 16px;border-right:1px solid #111111;vertical-align:top;",
  "fecha_grande": "$cond font-weight:800;font-size:58px;line-height:50px;color:#d7263d;white-space:nowrap;",
  "fecha_grande_tinta": "$cond font-weight:800;font-size:58px;line-height:50px;color:#0b2545;white-space:nowrap;",
  "fecha_grande_pie": "$mono font-size:11px;line-height:15px;letter-spacing:0.04em;text-transform:uppercase;color:#d7263d;padding-top:8px;",
  "fecha_grande_pie_tinta": "$mono font-size:11px;line-height:15px;letter-spacing:0.04em;text-transform:uppercase;color:#3d5573;padding-top:8px;",

  "item_titulo": "$sans font-weight:700;font-size:16px;line-height:22px;color:#0b2545;word-break:break-word;",
  "donde": "$mono font-size:12px;line-height:18px;color:#3d5573;padding-top:4px;word-break:break-word;",
  "texto_item": "$sans font-size:15px;line-height:22px;color:#0b2545;padding-top:8px;word-break:break-word;",
  "texto_nota": "$sans font-size:14px;line-height:20px;color:#3d5573;padding-top:6px;word-break:break-word;",
  "pie_item": "$mono font-size:12px;line-height:20px;color:#3d5573;padding-top:10px;",
  "marca_roja": "$mono font-weight:700;font-size:11px;line-height:15px;letter-spacing:0.06em;text-transform:uppercase;color:#d7263d;",
  "marca_tinta": "$mono font-weight:700;font-size:11px;line-height:15px;letter-spacing:0.06em;text-transform:uppercase;color:#0b2545;",

  "chip_nuevo": "$mono display:inline-block;font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;padding:3px 6px;background:#0b2545;color:#ffffff;",
  "chip_pendiente": "$mono display:inline-block;font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;padding:2px 5px;border:1px solid #0b2545;color:#0b2545;",
  "chip_en_curso": "$mono display:inline-block;font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;padding:3px 6px;background:#74acdf;color:#0b2545;",
  "chip_resuelto": "$mono display:inline-block;font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;padding:2px 5px;border:1px solid #3d5573;color:#3d5573;",
  "chip_descartado": "$mono display:inline-block;font-size:11px;line-height:13px;letter-spacing:0.06em;text-transform:uppercase;padding:3px 0;color:#3d5573;text-decoration:line-through;",

  "fila_lista": "padding:12px 16px 13px;border-top:1px solid #111111;$sans font-size:15px;line-height:22px;color:#0b2545;word-break:break-word;",
  "fila_lista_primera": "padding:12px 16px 13px;$sans font-size:15px;line-height:22px;color:#0b2545;word-break:break-word;",
  "fuerte": "font-weight:700;",
  "mono_inline": "$mono font-size:13px;color:#3d5573;",
  "codigo": "$mono font-size:0.9em;background:#dcebf7;padding:0 3px;color:#0b2545;word-break:break-word;",
  "vacio": "padding:12px 16px 13px;$sans font-size:15px;line-height:22px;color:#3d5573;word-break:break-word;",
  "enlace": "color:#0b2545;text-decoration:underline;",

  "numero_etiqueta": "padding:9px 12px 9px 16px;border-top:1px solid #111111;$sans font-size:15px;line-height:20px;color:#0b2545;word-break:break-word;",
  "numero_valor": "padding:9px 16px 9px 8px;border-top:1px solid #111111;$mono font-size:13px;line-height:20px;color:#0b2545;text-align:right;white-space:nowrap;",

  "api_nombre": "width:104px;padding:12px 10px 13px 16px;border-right:1px solid #111111;vertical-align:top;$cond font-weight:800;font-size:18px;line-height:18px;color:#0b2545;",

  "codigo_caja": "border:1px solid #111111;border-collapse:collapse;width:100%;margin-top:12px;",
  "codigo_archivo": "background:#74acdf;padding:5px 10px 4px;border-bottom:1px solid #111111;$mono font-size:12px;line-height:16px;color:#0b2545;",
  "codigo_margen": "width:14px;background:#dcebf7;padding:7px 0 8px 8px;vertical-align:top;$mono font-size:12px;line-height:18px;color:#0b2545;",
  "codigo_linea": "background:#dcebf7;padding:7px 10px 8px 6px;$mono font-size:12px;line-height:18px;color:#0b2545;white-space:pre-wrap;word-break:break-word;",

  "cierre": "padding:18px 16px 4px;border-top:2px solid #111111;",
  "celda_firma": "padding:12px 16px 20px;",
  "firma_nombre": "$sans font-weight:700;font-size:15px;line-height:22px;color:#0b2545;",
  "firma_linea": "$mono font-size:12px;line-height:18px;color:#3d5573;",
  "pie": "padding:14px 16px 16px;border-top:2px solid #111111;background:#ffffff;$sans font-size:13px;line-height:19px;color:#3d5573;",
  "enlace_pie": "color:#3d5573;text-decoration:underline;"
}
